    "marked": "^16.2.1",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4"
  },
  "overrides": {
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.28"
  }
